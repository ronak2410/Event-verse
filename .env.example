# EventVerse Environment Configuration
# Add your Google Gemini API Key here for live AI reasoning & generation.
# If omitted or invalid, the app gracefully falls back to deterministic, high-fidelity mock AI.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model (default: gemini-2.5-flash or gemini-1.5-flash)
NEXT_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
